# Jira Cloud
JIRA_URL=https://your-site.atlassian.net
JIRA_EMAIL=your-atlassian-email@example.com
JIRA_API_TOKEN=replace-with-api-token
JIRA_PROJECT_KEY=CAO

# Report delivery
REPORT_RECIPIENT=project-lead@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sender@gmail.com
SMTP_PASSWORD=replace-with-gmail-app-password

# Manual/local report options
REPORT_PERIOD=previous_week
ALL_STATUSES=true
STATUS_TO_DO=false
STATUS_IN_PROGRESS=false
STATUS_DONE=false
CUSTOM_START=
CUSTOM_END=
